{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppt-chapter-tutor/schemas/knowledge.schema.json",
  "title": "ChapterKnowledge",
  "description": "一章的知识点划分，必须能映射回 slide。",
  "type": "object",
  "required": ["chapter_id", "title", "source", "knowledge_points"],
  "additionalProperties": false,
  "properties": {
    "chapter_id": { "type": "string", "pattern": "^ch[0-9]{2,}$" },
    "title": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["file", "sha256", "slides"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "slides": { "type": "integer", "minimum": 1 },
        "has_notes": { "type": "boolean" },
        "image_only_slides": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "knowledge_points": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/knowledgePoint" }
    }
  },
  "$defs": {
    "knowledgePoint": {
      "type": "object",
      "required": ["id", "title", "slides", "summary"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^ch[0-9]{2,}\\.kp[0-9]{2,}$" },
        "title": { "type": "string", "minLength": 1 },
        "slides": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "summary": { "type": "string", "minLength": 1 },
        "importance": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
        "prerequisites": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ch[0-9]{2,}\\.kp[0-9]{2,}$" }
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
