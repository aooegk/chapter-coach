{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chapter-coach/schemas/quiz.schema.json",
  "title": "Quiz",
  "description": "试卷与答案（Agent 侧真源）。exam.html 由此生成。",
  "type": "object",
  "required": ["quiz_id", "chapter_id", "mode", "config", "questions"],
  "additionalProperties": false,
  "properties": {
    "quiz_id": { "type": "string", "pattern": "^[0-9]{8}-ch[0-9]{2,}-[0-9]{2}$" },
    "chapter_id": { "type": "string", "pattern": "^ch[0-9]{2,}$" },
    "title": { "type": "string" },
    "mode": { "enum": ["practice", "exam"] },
    "config": {
      "type": "object",
      "required": ["count", "types"],
      "additionalProperties": false,
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "types": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "duration_min": { "type": "integer", "minimum": 1 }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": ["id", "type", "kp_ids", "source", "source_slides", "stem", "max_score"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^q[0-9]{2,}$" },
        "type": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]*|custom:.+)$"
        },
        "type_label": { "type": "string" },
        "kp_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^ch[0-9]{2,}\\.kp[0-9]{2,}$" }
        },
        "source": { "enum": ["ppt", "real_exam", "web", "generated"] },
        "source_slides": {
          "type": "array",
          "minItems": 0,
          "items": { "type": "integer", "minimum": 1 }
        },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "stem": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "text"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "blanks": { "type": "integer", "minimum": 1 },
        "allow_image": {
          "type": "boolean",
          "description": "是否允许以拍照/上传图片的方式作答（手写证明、计算、作图等）。"
        },
        "max_attachments": { "type": "integer", "minimum": 1, "maximum": 5 },
        "answer": {
          "description": "客观题为字符串或数组；主观题为参考答案对象。",
          "type": ["string", "array", "object", "number", "boolean"]
        },
        "accepted_answers": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          }
        },
        "sql_context": {
          "type": "object",
          "required": ["dialect", "ddl"],
          "additionalProperties": false,
          "properties": {
            "dialect": { "type": "string" },
            "ddl": { "type": "string", "minLength": 1 },
            "rows": { "type": "string" },
            "expected_rows": { "type": "string" }
          }
        },
        "rubric": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["point", "weight"],
            "additionalProperties": false,
            "properties": {
              "point": { "type": "string", "minLength": 1 },
              "weight": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "explanation": { "type": "string" },
        "max_score": { "type": "number", "exclusiveMinimum": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "source": { "const": "generated" } },
            "required": ["source"]
          },
          "else": {
            "properties": { "source_slides": { "minItems": 1 } }
          }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["single_choice", "multi_select"] } },
            "required": ["type"]
          },
          "then": {
            "required": ["options", "answer"],
            "properties": {
              "options": { "minItems": 2 }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "true_false" } },
            "required": ["type"]
          },
          "then": { "required": ["answer"] }
        },
        {
          "if": {
            "properties": { "type": { "const": "sql" } },
            "required": ["type"]
          },
          "then": {
            "required": ["sql_context", "rubric"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "short_answer", "design", "code", "fill_blank",
                  "proof", "calculation", "solution", "programming",
                  "drawing", "translation", "essay", "case_analysis"
                ]
              }
            },
            "required": ["type"]
          },
          "then": { "required": ["rubric"] }
        }
      ]
    }
  }
}
